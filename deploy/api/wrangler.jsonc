{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ledgercraft-api",
  "account_id": "c611a72b3bacd0c105ab864d7006fca7",
  "main": "worker.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [
    { "name": "IDENTITY", "class_name": "Identity" },
    { "name": "LEDGERS", "class_name": "Ledger" }
  ]},
  "migrations": [{ "tag": "sqlite-v1", "new_sqlite_classes": ["Identity", "Ledger"] }],
  // PLACEHOLDER (issue #94 Phase 1): after Jeevan creates the private R2 bucket,
  // uncomment this binding and use a separate preview bucket. Do not enable it
  // until storage location and retention prerequisites have been reviewed.
  // "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "ledgercraft-documents" }],
  "vars": {
    "NODE_ENV": "production",
    "BETTER_AUTH_URL": "https://easybiz.iamjeevan.com",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://easybiz.iamjeevan.com,https://ledger-craft-app.pages.dev,easybizinvoice://",
    "SENTRY_DSN": "https://c70476b701f3fd7d5fb85254a73b3060@o4512292098342912.ingest.us.sentry.io/4512292100702208"
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  // Optional Worker secrets (set with `cd deploy/api && npx wrangler secret put NAME`):
  // RESEND_API_KEY + RESEND_FROM enable invoice/reminder/quote email; without both, clients offer share links.
  // OPENAI_API_KEY enables receipt/import AI; XAI_API_KEY is the fallback when OpenAI is absent.
  // Keep these optional: deployment must remain possible with honest unavailable capabilities.
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
