{
  "name": "web",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm --filter @ledgercraft/api dev",
    "start": "bash scripts/dev.sh",
    "dev:stack": "bash scripts/dev.sh",
    "test:api": "pnpm --filter @ledgercraft/api test",
    "test:contracts": "pnpm --filter @ledgercraft/contracts test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "type-check:api": "pnpm --filter @ledgercraft/api type-check && pnpm --filter @ledgercraft/contracts type-check",
    "verify:w1": "pnpm test:contracts && pnpm test:api && pnpm type-check:api",
    "verify:w2": "pnpm verify:w1",
    "verify:w3": "pnpm verify:w1",
    "verify:w4": "pnpm verify:w1",
    "verify:w5": "pnpm verify:w1",
    "verify:w6": "pnpm verify:w1",
    "verify:w7": "pnpm verify:w1",
    "verify:w8": "pnpm verify:w1",
    "verify:w9": "pnpm verify:w1",
    "verify:w11": "pnpm verify:w1",
    "verify:w12": "pnpm verify:w1",
    "verify:w13": "pnpm verify:w1",
    "prebuild": "node scripts/generate-version.js",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "postbuild": "node scripts/verify-build-version.mjs",
    "version:patch": "node scripts/auto-version.js patch",
    "version:minor": "node scripts/auto-version.js minor",
    "version:major": "node scripts/auto-version.js major",
    "release:patch": "npm run version:patch && git push && git push --tags",
    "release:minor": "npm run version:minor && git push && git push --tags",
    "release:major": "npm run version:major && git push && git push --tags",
    "install:hooks": "node scripts/install-git-hooks.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "type-check": "tsc --noEmit",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "deploy:check": "node scripts/deploy-cloudflare.mjs --check",
    "db:migrate": "pnpm --filter @ledgercraft/api db:migrate",
    "db:generate": "pnpm --filter @ledgercraft/api db:generate",
    "deploy:help": "node scripts/deploy-cloudflare.mjs --help"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@ledgercraft/contracts": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.56.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.1",
    "embla-carousel-react": "^8.3.0",
    "framer-motion": "^12.16.0",
    "html2canvas": "^1.4.1",
    "immer": "^11.1.21",
    "input-otp": "^1.2.4",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "openai": "^5.8.2",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.26.2",
    "react-to-print": "^3.1.0",
    "recharts": "^2.12.7",
    "resend": "^4.6.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.3",
    "workbox-window": "^7.3.0",
    "zod": "^3.24.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.53.1",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "lovable-tagger": "^1.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4",
    "wrangler": "4.131.0"
  },
  "packageManager": "pnpm@11.19.0"
}
