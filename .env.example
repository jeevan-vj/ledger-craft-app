# Hosted Supabase is gone. Clients talk to the Hono API.

# Server-side AI configuration. OPENAI_API_KEY is the required provider key;
# XAI_API_KEY is an optional alternative used only when no OpenAI key is set.
# OPENAI_API_KEY=
# XAI_API_KEY=
# Deprecated on the client. Never expose provider keys through Vite.
# VITE_OPENAI_API_KEY=

# E2E Testing Configuration
# These credentials are used for end-to-end testing with real user authentication
E2E_TEST_EMAIL=your_test_user_email@example.com
E2E_TEST_PASSWORD=your_test_user_password

# Email Service Configuration (Resend)
RESEND_API_KEY=your_resend_api_key
# OBJECT_STORE_DIR=
# Invoice imports default to the Durable Object-safe 1 MB cap and 20 PDF pages.
# Raise the byte cap only after the private DOCUMENTS R2 binding is enabled.
# INVOICE_IMPORT_MAX_BYTES=1048576
# INVOICE_IMPORT_MAX_PAGES=20
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Local Hono API + Postgres (W1 framework)
# App role — used by the API process. Never a superuser or table owner.
DATABASE_URL=postgres://ledgercraft_app:app@127.0.0.1:55432/ledgercraft
# Migrator role — drizzle migrations and test seeding only.
DATABASE_MIGRATE_URL=postgres://ledgercraft_migrator:migrator@127.0.0.1:55432/ledgercraft
# Superuser — optional local/CI bootstrap. Not used by the API.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:55432/ledgercraft
# API Vitest rewrites DATABASE_URL to ledgercraft_test so TRUNCATE cannot wipe local accounts.
# DATABASE_TEST_URL=postgres://ledgercraft_app:app@127.0.0.1:55432/ledgercraft_test
# DATABASE_TEST_MIGRATE_URL=postgres://ledgercraft_migrator:migrator@127.0.0.1:55432/ledgercraft_test
API_PORT=3001
# Bind 0.0.0.0 in containers. Local default is 127.0.0.1.
# API_HOST=0.0.0.0
# Better Auth (W3). Public URL is the Vite origin so cookies work through the /api proxy.
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081,http://127.0.0.1:8081,exp://127.0.0.1:8081,easybizinvoice://

# W4+ slices. Set false only in Vitest so legacy service tests keep using local stubs.
VITE_CUSTOMERS_API=true
VITE_BUSINESS_API=true
VITE_ITEMS_API=true
VITE_INVOICES_API=true
VITE_EXPENSES_API=true
VITE_PAYMENTS_API=true
VITE_ACCOUNTS_API=true
VITE_BANK_API=true
VITE_RECONCILIATION_API=true
VITE_TAX_API=true
VITE_STORAGE_API=true
VITE_RECEIPTS_API=true
VITE_AI_API=true
VITE_CONVERSATIONS_API=true
VITE_JOURNALS_API=true
EXPO_PUBLIC_CUSTOMERS_API=true
EXPO_PUBLIC_BUSINESS_API=true
EXPO_PUBLIC_ITEMS_API=true
EXPO_PUBLIC_INVOICES_API=true
EXPO_PUBLIC_EXPENSES_API=true
EXPO_PUBLIC_PAYMENTS_API=true
EXPO_PUBLIC_ACCOUNTS_API=true
EXPO_PUBLIC_STORAGE_API=true
EXPO_PUBLIC_RECEIPTS_API=true
EXPO_PUBLIC_AI_API=true
EXPO_PUBLIC_CONVERSATIONS_API=true
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
# Mobile crash reporting. Leave unset for local dev, Jest, and CI.
# Preview and production EAS profiles already set EXPO_PUBLIC_SENTRY_DSN and SENTRY_ORG.
# The optional EAS secret SENTRY_AUTH_TOKEN is documented in mobile/SENTRY.md.
# EXPO_PUBLIC_SENTRY_DSN=

# Cloudflare Pages Function proxy (production). Container origin, no trailing slash.
# API_ORIGIN=https://ledgercraft-api.example.com
# Android emulator: http://10.0.2.2:3001. Physical device: http://<lan-ip>:3001
EXPO_PUBLIC_APP_ORIGIN=http://127.0.0.1:8081

# Web error monitoring. Leave unset for local dev, tests, and CI.
# Production builds read VITE_SENTRY_DSN from the GitHub repository variable.
# The browser SDK loads after the first paint. Performance tracing is off.
# VITE_SENTRY_DSN=
# Set by the production release to the git SHA. Local builds fall back to the version hash.
# VITE_SENTRY_RELEASE=

# Note: Add your actual values to .env.local file
# The .env.local file should not be committed to version control
