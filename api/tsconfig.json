{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": "..",
    "paths": {
      "@ledgercraft/contracts": ["packages/contracts/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "../deploy/api/env.d.ts", "drizzle.config.ts", "vitest.config.ts"]
}
