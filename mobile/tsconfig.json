{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/shared/*": [
        "./shared/*"
      ],
      "hono/http-exception": [
        "./src/shims/hono-http-exception.ts"
      ],
      "hono/utils/http-status": [
        "./src/shims/hono-http-status.ts"
      ],
      "@ledgercraft/contracts": [
        "../packages/contracts/src/index.ts"
      ],
      "zod": [
        "./node_modules/zod"
      ]
    },
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "allowJs": true,
    "module": "ESNext"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
